# =============================================================================
# Event Catering — Environment template (safe to commit)
# Copy to .env.local for local. On Netlify: Site → Environment variables.
# OTP = Neon Auth built-in email ONLY (auth@mail.myneon.app). No Resend for OTP.
# =============================================================================

# ── Neon PostgreSQL ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ── Neon Auth ───────────────────────────────────────────────────────────────
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=change-me-to-at-least-32-random-characters
# Windows local only: set to false to keep strict TLS (default allows AV HTTPS inspection)
# ALLOW_INSECURE_TLS=false

# Optional (for npm run setup:neon-otp / restore:auth only — not needed at runtime)
# NEON_API_KEY=
# NEON_PROJECT_ID=
# NEON_BRANCH_ID=

# ── App secrets ─────────────────────────────────────────────────────────────
# AUTH_SECRET must be a random string — never paste the Neon Auth URL here
AUTH_SECRET=change-me-to-at-least-32-random-characters
INTERNAL_API_SECRET=change-me-to-at-least-32-random-characters
# Only if you keep a Neon webhook for NON-otp events:
# NEON_AUTH_WEBHOOK_SECRET=change-me-to-at-least-32-random-characters

# ── Admin allowlist ─────────────────────────────────────────────────────────
ADMIN_PHONE=+968XXXXXXXX
ADMIN_EMAIL=you@example.com

# ── Public site ─────────────────────────────────────────────────────────────
# Local: http://localhost:3000
# Production canonical: https://www.event-om.com
NEXT_PUBLIC_SITE_URL=https://www.event-om.com
NEXT_PUBLIC_WHATSAPP=96877222432

# ── SEO / Analytics (Google Search Console + GA4 + optional Clarity) ────────
# Search Console → Settings → Ownership verification → HTML tag → content=...
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GA4 → Admin → Data streams → Measurement ID (G-XXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
# Microsoft Clarity (optional heatmaps)
# NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx

# ── Payments / bank (optional until go-live) ────────────────────────────────
PAYMOB_BASE_URL=https://oman.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
NEXT_PUBLIC_PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_CURRENCY=OMR

BANK_NAME=Bank Muscat
BANK_ACCOUNT_NAME=Event Catering
BANK_ACCOUNT_NUMBER=
BANK_IBAN=
BANK_SWIFT=

# ── Image uploads (optional — admin package/service images) ─────────────────
# Prefer Cloudinary when set; else Netlify Blobs; else local public/uploads
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── AI (admin tools) ────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Twilio (phone OTP / SMS — optional; email OTP uses Neon) ────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# ── Turnstile (optional; set ALLOW_MISSING_TURNSTILE=true for local) ────────
# NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
# CLOUDFLARE_TURNSTILE_SECRET_KEY=
ALLOW_MISSING_TURNSTILE=true

TRUST_CLOUDFLARE_PROXY=false

# ── Rate limit (optional Upstash) ───────────────────────────────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Resend (order confirmation + PDF invoice + admin alert — NOT for OTP) ───
# Required for emails after a customer submits a hospitality request.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=Event Catering <noreply@yourdomain.com>
# RESEND_ACCOUNT_EMAIL=your-resend-account@email.com
# Sandbox (onboarding@resend.dev) only delivers to the Resend account owner.
