# Neon PostgreSQL

DATABASE_URL=postgresql://user:password@host/db?sslmode=require



# Neon Auth (from Neon Console → Auth)

NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth

NEON_AUTH_COOKIE_SECRET=change-me-to-at-least-32-random-characters



# Phone OTP session signing (min 32 chars; do NOT reuse admin tokens)

AUTH_SECRET=change-me-to-at-least-32-random-characters



# Internal server-to-server API (send-confirmation emails/PDFs)

INTERNAL_API_SECRET=change-me-to-at-least-32-random-characters



# Neon Auth webhook shared secret (set same value in Neon Console webhook headers)

# Header: x-webhook-secret: <your-secret>

NEON_AUTH_WEBHOOK_SECRET=change-me-to-at-least-32-random-characters



# Admin

ADMIN_PHONE=+96877222432

ADMIN_EMAIL=you@example.com



# Resend (OTP email delivery via Neon Auth webhook)

RESEND_API_KEY=re_xxxxxxxx

# Optional: verified sender in Resend. Default is onboarding@resend.dev

# RESEND_FROM_EMAIL=Speedy Cleaning <noreply@yourdomain.com>



# Public site

NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_WHATSAPP=96877222432



# Gemini AI

GEMINI_API_KEY=your-gemini-api-key



# Twilio SMS — required so ANY user receives OTP on their phone

# TWILIO_ACCOUNT_SID must start with AC (Console → Account info). Do NOT put SK... here.

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

TWILIO_AUTH_TOKEN=your_auth_token

# Optional API Key auth instead of Auth Token:

# TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TWILIO_API_SECRET=your_api_secret

TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: only if you buy a Twilio sender number (NOT an Oman mobile)

# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX



# Neon Auth webhook URL (Console):

# https://your-site.com/api/webhooks/neon-auth

# Add custom header: x-webhook-secret = NEON_AUTH_WEBHOOK_SECRET value above



# Cloudflare Turnstile (bot protection on OTP + booking)

# Dashboard: Cloudflare → Turnstile → Add site → get Site Key + Secret Key

NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxx

CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxx



# Cloudflare proxy (production): block direct origin access when orange-cloud is ON

# Set to true only after DNS points through Cloudflare (orange cloud)

TRUST_CLOUDFLARE_PROXY=false



# Upstash Redis (distributed rate limiting — works behind Cloudflare)

# Create free DB: https://console.upstash.com → REST API → copy URL + token

UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io

UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx



# Cloudflare DNS setup (manual in dashboard):

# 1. Add your domain to Cloudflare

# 2. Point A/CNAME to your host (Vercel, etc.)

# 3. Enable orange cloud (Proxied) on the root + www records

# 4. SSL/TLS mode: Full (strict)

# 5. Enable Bot Fight Mode + Rate Limiting rules for /api/phone/* if needed

# 6. Turnstile widget protects forms in-app; edge rules add extra layer

