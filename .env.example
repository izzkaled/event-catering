# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Neon Auth (from Neon Console → Auth)
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=change-me-to-at-least-32-random-characters

# Admin
ADMIN_PHONE=+96877222432
ADMIN_EMAIL=you@example.com

# Resend (OTP email delivery via Neon Auth webhook)
RESEND_API_KEY=re_xxxxxxxx
# Optional: verified sender in Resend. Default is onboarding@resend.dev
# RESEND_FROM_EMAIL=<izzkaled@gmail.com>

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=96877222432

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Twilio SMS — required so ANY user receives OTP on their phone
# TWILIO_ACCOUNT_SID must start with AC (Console → Account info). Do NOT put SK... here.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Optional API Key auth instead of Auth Token:
# TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_SECRET=your_api_secret
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: only if you buy a Twilio sender number (NOT an Oman mobile)
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Neon Auth webhook URL (Console):
# https://your-site.com/api/webhooks/neon-auth
