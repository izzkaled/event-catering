# Neon PostgreSQL

DATABASE_URL=postgresql://user:password@host/db?sslmode=require



# Neon Auth (from Neon Console → Auth)

NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth

NEON_AUTH_COOKIE_SECRET=change-me-to-at-least-32-random-characters



# Phone OTP session signing (min 32 chars; do NOT reuse admin tokens)

AUTH_SECRET=change-me-to-at-least-32-random-characters



# Internal server-to-server API (send-confirmation emails/PDFs)

INTERNAL_API_SECRET=change-me-to-at-least-32-random-characters



# Neon Auth webhook (Console → Auth → Webhooks)
# URL: https://your-site.com/api/webhooks/neon-auth
# Events: send.otp (required for custom email delivery via Resend)
# Neon signs requests with X-Neon-Signature (Ed25519) — no custom header needed.
# Optional: NEON_AUTH_WEBHOOK_SECRET for manual curl testing only (x-webhook-secret header)
NEON_AUTH_WEBHOOK_SECRET=change-me-to-at-least-32-random-characters



# Admin

ADMIN_PHONE=+968XXXXXXXX

ADMIN_EMAIL=you@example.com



# Neon API (one-time OTP setup: node scripts/setup-otp-delivery.mjs)
NEON_API_KEY=neon_api_key_xxxxxxxx
# Optional overrides for setup script (defaults: cleanplus-new / main branch)
# NEON_PROJECT_ID=holy-haze-60700006
# NEON_BRANCH_ID=br-restless-union-aj01lw4h

# Resend (OTP email delivery when Neon send.otp webhook is enabled)
RESEND_API_KEY=re_xxxxxxxx
# Default sender onboarding@resend.dev only delivers to your Resend account email.
# For any user email, verify a domain in Resend and set:
# RESEND_FROM_EMAIL=Speedy Cleaning <noreply@yourdomain.com>



# Public site

NEXT_PUBLIC_SITE_URL=https://clean-plus1.netlify.app

NEXT_PUBLIC_WHATSAPP=96877222432



# Stripe (legacy — optional; prefer Paymob below)
# Dashboard: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# STRIPE_CURRENCY=usd
# STRIPE_OMR_EXCHANGE_RATE=2.597



# Paymob (card / Apple Pay / wallets — Oman)
# Dashboard: https://oman.paymob.com (use accept./ksa./uae. for other regions)
# PAYMOB_BASE_URL defaults to https://oman.paymob.com
PAYMOB_BASE_URL=https://oman.paymob.com
# TEST keys only (from Paymob dashboard → API Keys). Never commit live keys.
PAYMOB_SECRET_KEY=omn_sk_test_xxxxxxxx
PAYMOB_PUBLIC_KEY=omn_pk_test_xxxxxxxx
NEXT_PUBLIC_PAYMOB_PUBLIC_KEY=omn_pk_test_xxxxxxxx
PAYMOB_INTEGRATION_ID=your_test_integration_id
# Optional: PAYMOB_INTEGRATION_ID_CARD=your_test_integration_id
PAYMOB_HMAC_SECRET=your_hmac_secret
PAYMOB_CURRENCY=OMR
# OMR uses 1000 minor units; override if needed:
# PAYMOB_AMOUNT_MULTIPLIER=1000
# Webhook URL (Paymob Dashboard + notification_url): https://your-site.com/api/payment/webhook



# Bank transfer (manual verification)
BANK_NAME=Bank Muscat
BANK_ACCOUNT_NAME=Speedy Cleaning
BANK_ACCOUNT_NUMBER=xxxxxxxxxxxx
BANK_IBAN=OMxxxxxxxxxxxxxxxxxxxxxxxx
BANK_SWIFT=BMUSOMRXXXX



# Cloudinary (optional — bank receipt uploads; otherwise stored as data URL)
# CLOUDINARY_CLOUD_NAME=your_cloud
# CLOUDINARY_API_KEY=xxxx
# CLOUDINARY_API_SECRET=xxxx



# Gemini AI

GEMINI_API_KEY=your-gemini-api-key



# Twilio SMS — required so ANY user receives OTP on their phone

# TWILIO_ACCOUNT_SID must start with AC (Console → Account info). Do NOT put SK... here.

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

TWILIO_AUTH_TOKEN=your_auth_token

# Optional API Key auth instead of Auth Token:

# TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TWILIO_API_SECRET=your_api_secret

TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: only if you buy a Twilio sender number (NOT an Oman mobile)

# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX



# Neon Auth webhook URL (Console):

# https://your-site.com/api/webhooks/neon-auth

# Add custom header: x-webhook-secret = NEON_AUTH_WEBHOOK_SECRET value above



# Cloudflare Turnstile (bot protection on OTP + booking)

# Dashboard: Cloudflare → Turnstile → Add site → get Site Key + Secret Key

NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxx

CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxx

# Temporary only: allow OTP/booking without Turnstile in production (not recommended)
# ALLOW_MISSING_TURNSTILE=true



# Cloudflare proxy (production): block direct origin access when orange-cloud is ON

# Set to true only after DNS points through Cloudflare (orange cloud)

TRUST_CLOUDFLARE_PROXY=false



# Upstash Redis (distributed rate limiting — works behind Cloudflare)

# Create free DB: https://console.upstash.com → REST API → copy URL + token

UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io

UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx



# Cloudflare DNS setup (manual in dashboard):

# 1. Add your domain to Cloudflare

# 2. Point A/CNAME to your host (Vercel, etc.)

# 3. Enable orange cloud (Proxied) on the root + www records

# 4. SSL/TLS mode: Full (strict)

# 5. Enable Bot Fight Mode + Rate Limiting rules for /api/phone/* if needed

# 6. Turnstile widget protects forms in-app; edge rules add extra layer

